   "outputs": [],
   "source": [
    "import ten\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "b2b996ce-e9d6-4aec-9f4c-7aef11e50bca",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = ten.arange((8), -4.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "660c338a-e147-4428-8bf7-c7a686011937",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "tensor<complex<float32>,8>\n",
       "(-4,0)\n",
       "(-4,9.65685)\n",
       "(-4,4)\n",
       "(-4,1.65686)\n",
       "(-4,4.62535e-06)\n",
       "(-4,-1.65685)\n",
       "(-4.00001,-4)\n",
       "(-4.00001,-9.65686)"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "ten.fft(x)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "c67607a3-2e0c-4a20-b927-c075829727e5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([-4.+0.j       , -4.+9.656855j , -4.+4.j       , -4.+1.6568543j,\n",
       "       -4.+0.j       , -4.-1.6568543j, -4.-4.j       , -4.-9.656855j ],\n",
       "      dtype=complex64)"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "np.fft.fft(x.to_numpy())"
   ]
  },
